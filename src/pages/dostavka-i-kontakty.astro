---
import Base from '../layouts/Base.astro';
import { site } from '../data/settings';
---

<Base title="Доставка, оплата и контакты — Василиса" description="Доставка по Санкт-Петербургу и Ленинградской области, оплата, контакты мастерской «Василиса».">
  <div class="container breadcrumbs"><a href="/">Главная</a> / Доставка, оплата и контакты</div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Доставка и оплата</span>
          <h1>Доставка, оплата и контакты</h1>
        </div>
      </div>

      <div class="features-grid" style="border:1px solid var(--line); border-radius:var(--radius); overflow:hidden">
        <div class="feature">
          <div class="feature-icon">▦</div>
          <h3>Доставка</h3>
          <p>Санкт-Петербург и Ленинградская область. Стоимость рассчитывается отдельно.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">₽</div>
          <h3>Оплата</h3>
          <p>Предоплата при заказе, остаток — после монтажа. Чеки через «Мой налог».</p>
        </div>
        <div class="feature">
          <div class="feature-icon">◆</div>
          <h3>Гарантия</h3>
          <p>2 года на изделия. Условия фиксируем в договоре.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">✆</div>
          <h3>Связь</h3>
          <p>Звонок, WhatsApp или Telegram — ответим в рабочее время.</p>
        </div>
      </div>

      <div class="about" style="margin-top:56px">
        <div>
          <span class="eyebrow">Контакты</span>
          <h2>Свяжитесь с нами</h2>
          <p class="muted">Телефон: <a href={site.phoneHref} style="color:var(--accent)">{site.phone}</a></p>
          <p class="muted">WhatsApp и Telegram — по кнопкам ниже.</p>
          <p class="muted">Город: {site.city}</p>
          <div class="model-actions">
            <a class="btn btn-primary" href={site.phoneHref}>Позвонить</a>
            <a class="btn btn-ghost" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
            <a class="btn btn-ghost" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
          </div>
        </div>
        <div class="about-media">
          <img src="/img/shkaf-1.png" alt="Мебель Василиса" />
        </div>
      </div>
    </div>
  </section>
</Base>
